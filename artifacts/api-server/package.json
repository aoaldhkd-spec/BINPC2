{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "corepack pnpm run build && corepack pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --dns-result-order=ipv4first --env-file-if-exists=.env --enable-source-maps ./dist/index.mjs",
    "setup:env": "node ./scripts/setup-env.mjs",
    "typecheck": "tsc -b ../../lib/api-zod && tsc -p tsconfig.json --noEmit",
    "test:pin": "node --test tests/pin-exhaustion.test.mjs",
    "test:admin-push": "node --test tests/admin-db-failure-push.test.mjs",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@types/express-session": "^1.19.0",
    "@types/pg": "^8.20.0",
    "@workspace/api-zod": "workspace:*",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.0",
    "thread-stream": "3.1.0",
    "vitest": "4.1.10"
  }
}
