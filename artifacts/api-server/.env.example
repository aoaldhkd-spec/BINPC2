# Supabase: Project Settings > Database > Connection string
# Use direct/session port for LISTEN/NOTIFY (avoid transaction pooler 6543).
# On Render, prefer Supabase Connect → Session pooler → URI (port 5432),
# not Direct host if you see ENETUNREACH / IPv6 errors in logs.
DATABASE_URL=

# Generate a long random value; never commit the real value.
SESSION_SECRET=

PORT=8080

# Cap app pool below Supabase session-pooler max_clients (EMAXCONNSESSION).
# Default/render.yaml use 10; leave headroom for the dedicated LISTEN client.
# Code hard-caps at 10 even if this env is higher — still set it on Render:
#   Dashboard → binpc2-api → Environment → PG_POOL_MAX=10 (or lower), then Manual Deploy.
# PG_POOL_MAX=10

# Optional: required only for browser push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Deployment (not read by the server at runtime) ---
# 1) Deploy API (Render/Fly/Railway) with DATABASE_URL + SESSION_SECRET above.
# 2) Deploy frontend on Netlify; set site env API_URL=https://YOUR-API-HOST
# 3) In admin /admin → QR tab, save PUBLIC_APP_URL (https://YOUR-NETLIFY-SITE)
